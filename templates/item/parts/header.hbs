<header class="sheet-header item-header">
  <img class="profile-img" src="{{item.img}}" data-action="editImage" data-edit="img" alt="{{item.name}}">
  <div class="header-fields">
    <input class="name-input" name="name" type="text" value="{{item.name}}">
    <span class="item-type">{{sw5eLabel (concat "TYPES.Item." item.type)}}</span>
  </div>
</header>
