<section class="tab inventory {{#if tabs.inventory.active}}active{{/if}}" data-tab="inventory" data-group="primary">
  <fieldset>
    <legend>{{sw5eLabel 'SW5E.Weapons'}}
      <a data-action="itemCreate" data-type="weapon"><i class="fas fa-plus"></i></a>
    </legend>
    <ul class="item-list">
      {{#each items.weapons as |i|}}
      <li>
        <span class="name" data-action="itemRoll" data-item-id="{{i.id}}">{{i.name}}</span>
        <a data-action="itemEdit" data-item-id="{{i.id}}"><i class="fas fa-edit"></i></a>
        <a data-action="itemDelete" data-item-id="{{i.id}}"><i class="fas fa-trash"></i></a>
      </li>
      {{/each}}
    </ul>
  </fieldset>
  <fieldset>
    <legend>{{sw5eLabel 'SW5E.Armor'}}
      <a data-action="itemCreate" data-type="armor"><i class="fas fa-plus"></i></a>
    </legend>
    <ul class="item-list">
      {{#each items.armor as |i|}}
      <li><span class="name">{{i.name}}</span><a data-action="itemEdit" data-item-id="{{i.id}}"><i class="fas fa-edit"></i></a><a data-action="itemDelete" data-item-id="{{i.id}}"><i class="fas fa-trash"></i></a></li>
      {{/each}}
    </ul>
  </fieldset>
  <fieldset>
    <legend>{{sw5eLabel 'SW5E.Gear'}}
      <a data-action="itemCreate" data-type="gear"><i class="fas fa-plus"></i></a>
    </legend>
    <ul class="item-list">
      {{#each items.gear as |i|}}
      <li><span class="name" data-action="itemRoll" data-item-id="{{i.id}}">{{i.name}}</span><a data-action="itemEdit" data-item-id="{{i.id}}"><i class="fas fa-edit"></i></a><a data-action="itemDelete" data-item-id="{{i.id}}"><i class="fas fa-trash"></i></a></li>
      {{/each}}
    </ul>
  </fieldset>
</section>
